{
  "compilerOptions": {
    "paths": {
      "@ecommerce/error-handler": ["./packages/error-handler/index.ts"],
      "@ecommerce/prisma": ["./packages/libs/prisma/index.ts"],
      "@ecommerce/redis": ["./packages/libs/redis/index.ts"]
    },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@ecommerce/source"]
  }
}
