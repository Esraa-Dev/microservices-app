{
  "compilerOptions": {
    "paths": {
      "@ecommerce/error-handler": ["./packages/error-handler/index.ts"],
      "@ecommerce/prisma": ["./packages/libs/prisma/index.ts"],
      "@ecommerce/redis": ["./packages/libs/redis/index.ts"],
      "@ecommerce/middleware": ["./packages/middleware/index.ts"],
      "@ecommerce/components/*": ["./packages/components/*"],
      "@ecommerce/components": ["./packages/components"]
    },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
  }
}