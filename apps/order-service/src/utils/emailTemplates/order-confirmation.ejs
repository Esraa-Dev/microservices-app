<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation</title>
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fafafa;
      color: #1d1d1d;
      margin: 0;
      padding: 0;
    }
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Poppins', sans-serif;
    }
  </style>
</head>
<body style="background-color: #fafafa; padding: 30px 0;">
  <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden;">
    
    <!-- Header -->
    <tr>
      <td align="center" style="background-color: #e37937; padding: 24px; color: #ffffff;">
        <h1 style="margin: 0; font-size: 24px; font-weight: 600;">Order Confirmed! 🌺</h1>
      </td>
    </tr>

    <!-- Greeting & Intro -->
    <tr>
      <td style="padding: 24px 30px 10px 30px;">
        <p style="font-size: 16px; margin: 0 0 10px 0;">Hello <strong><%= name %></strong>,</p>
        <p style="font-size: 15px; color: #4a4a4a; margin: 0;">Thank you for your purchase! We’ve received your order and are getting it ready for shipment.</p>
      </td>
    </tr>

    <!-- Order Items Table -->
    <tr>
      <td style="padding: 20px 30px;">
        <h3 style="font-size: 18px; border-bottom: 2px solid #e5e5e5; padding-bottom: 8px; margin-top: 0;">Order Summary</h3>
        <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid #e5e5e5; text-align: left;">
              <th style="padding: 10px 0; font-size: 14px; color: #555555;">Product</th>
              <th style="padding: 10px 0; font-size: 14px; color: #555555; text-align: center;">Qty</th>
              <th style="padding: 10px 0; font-size: 14px; color: #555555; text-align: right;">Price</th>
            </tr>
          </thead>
          <tbody>
            <% cart.forEach(item => { %>
              <tr style="border-bottom: 1px solid #f0f0f0;">
                <td style="padding: 12px 0; font-size: 14px;">
                  <%= item.title || item.name || 'Product Item' %>
                  <% if (item.selectedOptions && Object.keys(item.selectedOptions).length > 0) { %>
                    <br><span style="font-size: 12px; color: #8a8a8a;">
                      <% Object.entries(item.selectedOptions).forEach(([key, val]) => { %>
                        <%= key %>: <%= val %> 
                      <% }) %>
                    </span>
                  <% } %>
                </td>
                <td style="padding: 12px 0; font-size: 14px; text-align: center;"><%= item.quantity %></td>
                <td style="padding: 12px 0; font-size: 14px; text-align: right;">$<%= (item.sale_price * item.quantity).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </td>
    </tr>

    <!-- Total Amount Section -->
    <tr>
      <td style="padding: 0 30px 24px 30px;">
        <table width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <td style="padding: 8px 0; font-size: 16px; font-weight: 600; text-align: right; color: #1d1d1d;">
              Total Paid: <span style="color: #e37937; font-size: 18px;">$<%= Number(totalAmount).toFixed(2) %></span>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Tracking Button -->
    <tr>
      <td align="center" style="padding: 10px 30px 30px 30px;">
        <a href="<%= trackingUrl %>" target="_blank" style="background-color: #e37937; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; font-size: 15px;">Track Your Order</a>
      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td align="center" style="background-color: #fafafa; padding: 20px; border-top: 1px solid #e5e5e5; color: #9a9a9a; font-size: 13px;">
        <p style="margin: 0;">If you have any questions, feel free to reply to this email.</p>
        <p style="margin: 5px 0 0 0;">&copy; 2026 E-Commerce Platform. All rights reserved.</p>
      </td>
    </tr>

  </table>
</body>
</html>